# ====================================================================
# UNCERTAIN INCOME PLANNER - ENVIRONMENT EXAMPLE
# ====================================================================

# Google Cloud OAuth 2.0 Web Application Client ID
# Configure in Google Cloud Console -> APIs & Services -> Credentials
# Authorized JavaScript Origins: http://localhost:5174, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server Configuration
PORT=3001
NODE_ENV=development
SESSION_SECRET=your-random-32-byte-secret
APP_ORIGIN=http://localhost:5174

# Supabase PostgreSQL & Auth Configuration
# Obtain from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
