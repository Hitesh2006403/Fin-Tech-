# Google Cloud OAuth 2.0 Web Application Client ID
# Configure in Google Cloud Console -> APIs & Services -> Credentials
# Authorized JavaScript Origins: http://localhost:5174, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server Configuration
PORT=3001
NODE_ENV=development
SESSION_SECRET=your-random-32-byte-secret
APP_ORIGIN=http://localhost:5174
